# Cloudflare R2 — the origin for all heavy media.
#
# Every image, video and audio file is served from R2, never committed to this repo
# and never served from the app host (CLAUDE.md, hard rule 3). R2 gives zero egress,
# which is what keeps the site inside the Vercel Hobby bandwidth cap (PROJECT.md §7).
#
# Copy to .env.local and fill in. .env.local is gitignored; this file never holds values.


# --- Phase 1 needs this one variable and nothing else -----------------------------

# Public read base URL for media, with no trailing slash.
#
# The browser fetches media straight from here, so Phase 1 needs no R2 credentials at
# all — there is no upload path and no signing until Payload arrives in Phase 2.
#
# Today this is the bucket's Public Development URL (https://pub-<hash>.r2.dev).
# Cloudflare rate-limits that URL and serves it with caching and Access unavailable,
# so it is a development value only. Before launch this must become a custom domain
# on the bucket — which is blocked until the domain in PROJECT.md §7 is registered.
# Swapping it is a one-line change here, provided content stores R2 object keys rather
# than absolute URLs.
NEXT_PUBLIC_R2_PUBLIC_URL=


# --- Phase 2 (Payload + S3 adapter). Not required to run the site today -----------

# Cloudflare account ID. Dashboard -> Workers & Pages -> Overview, right-hand sidebar.
R2_ACCOUNT_ID=

# S3-compatible API credentials. Dashboard -> R2 -> Manage API Tokens.
# Server-only. Must never be read from a client component or prefixed NEXT_PUBLIC_.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Name of the bucket holding the media.
R2_BUCKET_NAME=

# S3-compatible endpoint for that account:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
