# Cloudflare R2 — the origin for all heavy media.
#
# Every image, video and audio file is served from R2, never committed to this repo
# and never served from the app host (CLAUDE.md, hard rule 3). R2 gives zero egress,
# which is what keeps the site inside the Vercel Hobby bandwidth cap (PROJECT.md §7).
#
# Copy to .env.local and fill in. .env.local is gitignored; this file never holds values.

# Cloudflare account ID. Dashboard -> Workers & Pages -> Overview, right-hand sidebar.
R2_ACCOUNT_ID=

# S3-compatible API credentials. Dashboard -> R2 -> Manage API Tokens.
# Server-only. Must never be read from a client component.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Name of the bucket holding the media.
R2_BUCKET_NAME=

# S3-compatible endpoint for that account:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Public read base URL for media, i.e. the bucket's custom domain.
# A custom domain (not the r2.dev dev URL) is what keeps egress free and responses
# cacheable. This one is client-visible by design, hence NEXT_PUBLIC_.
NEXT_PUBLIC_R2_PUBLIC_URL=
